# 数据库配置
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=ruoyi-vue-pro
REDIS_PASSWORD=123456

# Java虚拟机配置
JAVA_OPTS=-Xms512m -Xmx2048m

# Redis配置
REDIS_HOST=yudao-redis

# 后端镜像
BACKEND_IMAGE=registry.cn-beijing.aliyuncs.com/liam_test/ruoyi-vue-pro:2026-01-15-14-09-29
# 前端镜像
FRONTEND_IMAGE=registry.cn-beijing.aliyuncs.com/liam_test/yudao-ui-admin-vue3:2026-01-15-16-25-30


# mysql backup 相关
# 备份保留策略
DAYS_TO_KEEP=7
WEEKS_TO_KEEP=4
MONTHS_TO_KEEP=6

# 阿里云OSS配置（留空则禁用OSS备份）
OSS_ENABLED=false
OSS_BUCKET_NAME=your-backup-bucket
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# 邮件通知配置（留空则禁用邮件通知）
ENABLE_EMAIL=false
EMAIL_ADDRESS=admin@example.com

# 备份目录（确保有足够权限和空间）
BACKUP_DIR=/opt/yudao/backups/mysql